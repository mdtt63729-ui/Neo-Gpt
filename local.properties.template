# Copy this file to local.properties and set the path to your Android SDK
# This file should NOT be committed to git (it's in .gitignore)
# GitHub Actions will set up the SDK automatically — you only need this for local builds

sdk.dir=/Users/yourusername/Library/Android/sdk
